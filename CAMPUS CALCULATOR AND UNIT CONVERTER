def calculator():
    print("====SCIENTIFIC CALCULATOR====")
    a = float(input("enter the first value:"))
    b = float(input("enter the second value:"))
    op = input("choose an operator: + - * ^ /:")
    if op == '-': r = a - b
    elif op == '+': r = a + b
    elif op == '*': r = a * b
    elif op == '^': r = a ^ b
    elif op == '/': r = a / b
    else: r = "Invalid"
    print(f"Result", r)
    save_history(f"Calc: {a} {op} {b} = {r}")
    
