#MY MENU IN PYTHON
menu = {"rice": 4.00,
       "matooke": 5.40,
       "chips": 2.25,
       "rolex": 2.00,
        "meat beef": 8.50,
        "chicken": 15.50,
       "juice": 1.50,
       "fried chappati": 2.00,
       "chai mata": 2.00,}
cart = []
total = 0
print("====ENGINEER IGNI RESTAURANT AND TAKE AWAY========")
print("============MENU_CARD========")
for key, value in menu.items():
    print(f"{key:}: ${value:.2f}")
print("=============================")
while True:
    food = input("select an item(q to quit):").lower()
    if food == 'q':
        break
    elif menu.get(food)is not None:
        cart.append(food) 
print()
print("=====YOUR ORDER=======")
for food in cart:
    total += menu.get(food)
    print(food, end="")
print()
print(f"Total is: ${total:.2f}")
